{
  "name": "rise-lagos",
  "version": "1.0.0",
  "private": true,
  "description": "Rise: Hustle or Die Trying — Unity edition (unity/), shared map and content data (src/data) and the Next.js site (web/)",
  "type": "module",
  "scripts": {
    "check": "for f in $(find src -name '*.js'); do node --check \"$f\" || exit 1; done && echo 'data modules OK' && node scripts/check-data.mjs",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "export:unity": "node scripts/export-world.mjs",
    "export:check": "node scripts/export-world.mjs && git diff --exit-code unity/Assets/Rise/Resources/world/lagos.json unity/Assets/Rise/Resources/world/manifest.json",
    "unity:compile": "node scripts/build-unity.mjs compile",
    "unity:smoke": "node scripts/build-unity.mjs smoke",
    "unity:test": "node scripts/build-unity.mjs playtest",
    "unity:validate": "node scripts/build-unity.mjs validate",
    "build:webgl": "node scripts/build-unity.mjs webgl",
    "build:mac": "node scripts/build-unity.mjs mac",
    "build:windows": "node scripts/build-unity.mjs windows",
    "build:ios": "node scripts/build-unity.mjs ios",
    "build:android": "node scripts/build-unity.mjs android",
    "build:all": "node scripts/build-unity.mjs all",
    "build:manifest": "node scripts/deploy.mjs manifest",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "package:webgl": "node scripts/package-webgl.mjs",
    "deploy:itch": "node scripts/deploy.mjs itch",
    "deploy:render": "node scripts/deploy.mjs render",
    "deploy:supabase": "node scripts/deploy.mjs supabase",
    "release": "node scripts/deploy.mjs release",
    "release:full": "node scripts/deploy.mjs release --full",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "postinstall": "node scripts/render-build.mjs",
    "build": "npm --prefix web install --include=dev && npm --prefix web run build",
    "start": "npm --prefix web run start"
  }
}
